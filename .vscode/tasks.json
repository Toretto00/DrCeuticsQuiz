{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/DrCeuticsQuiz.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Xuất file .exe cho Windows (standee)",
      "command": "dotnet",
      "type": "process",
      "args": ["publish", "${workspaceFolder}/DrCeuticsQuiz.csproj", "-c", "Release", "-r", "win-x64",
               "--self-contained", "true", "-p:PublishSingleFile=true",
               "-p:IncludeNativeLibrariesForSelfExtract=true", "-o", "${workspaceFolder}/publish/win-x64"],
      "problemMatcher": "$msCompile"
    }
  ]
}

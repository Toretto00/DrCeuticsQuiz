<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AssemblyName>DrCeuticsQuiz</AssemblyName>
    <RootNamespace>DrCeuticsQuiz</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- File câu hỏi nằm cạnh file .exe để sửa không cần build lại -->
  <ItemGroup>
    <None Update="questions.json" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="logo.png" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('logo.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
  </ItemGroup>
</Project>

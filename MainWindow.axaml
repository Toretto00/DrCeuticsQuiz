<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:DrCeuticsQuiz.Controls"
        x:Class="DrCeuticsQuiz.MainWindow"
        Title="DrCeutics – Đố vui cùng Olive"
        Background="#1B1B1B"
        Width="540" Height="960">

    <Window.Resources>
        <FontFamily x:Key="Baloo">avares://DrCeuticsQuiz/Assets/Fonts#Mont ExtraBold</FontFamily>
        <FontFamily x:Key="BvpMedium">avares://DrCeuticsQuiz/Assets/Fonts#Mont Medium</FontFamily>
        <FontFamily x:Key="BvpBold">avares://DrCeuticsQuiz/Assets/Fonts#Mont Bold</FontFamily>
        <SolidColorBrush x:Key="Brown" Color="#A8613A" />
        <SolidColorBrush x:Key="BrownDark" Color="#5B2A17" />
        <SolidColorBrush x:Key="Olive" Color="#A6B858" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BvpMedium}" />
            <Setter Property="Foreground" Value="#5B2A17" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource Baloo}" />
            <Setter Property="Foreground" Value="#A8613A" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="54" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.logo">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Height" Value="120" />
            <Setter Property="MinWidth" Value="430" />
            <Setter Property="Padding" Value="44,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="BoxShadow" Value="0 6 0 0 #145B2A17" />
        </Style>
        <Style Selector="Panel.screen">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Rectangle.px">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Rectangle.s">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
    </Window.Styles>

    <!-- Khung thiết kế cố định 1080 x 1920 – Viewbox tự co giãn theo màn hình standee -->
    <Viewbox Stretch="Uniform">
        <Panel Width="1080" Height="1920" ClipToBounds="True">
            <Panel.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F6E2D2" Offset="0" />
                    <GradientStop Color="#F7EEDB" Offset="0.45" />
                    <GradientStop Color="#EEF0CF" Offset="0.8" />
                    <GradientStop Color="#E2EAB8" Offset="1" />
                </LinearGradientBrush>
            </Panel.Background>

            <!-- ================= MÀN HÌNH CHỜ ================= -->
            <Panel x:Name="HomeScreen" Classes="screen" Background="Transparent">
                <!-- Ô pixel trang trí -->
                <Canvas>
                    <Rectangle Classes="px"   Fill="#A8613A" Canvas.Left="110" Canvas.Top="340" />
                    <Rectangle Classes="px s" Fill="#A6B858" Canvas.Left="165" Canvas.Top="305" />
                    <Rectangle Classes="px s" Fill="#5B2A17" Canvas.Left="905" Canvas.Top="370" />
                    <Rectangle Classes="px"   Fill="#A6B858" Canvas.Left="945" Canvas.Top="325" />
                    <Rectangle Classes="px"   Fill="#D9E3A0" Canvas.Left="80"  Canvas.Top="1060" />
                    <Rectangle Classes="px s" Fill="#A8613A" Canvas.Left="130" Canvas.Top="1110" />
                    <Rectangle Classes="px"   Fill="#5B2A17" Canvas.Left="965" Canvas.Top="1150" />
                    <Rectangle Classes="px s" Fill="#A6B858" Canvas.Left="925" Canvas.Top="1110" />
                    <Rectangle Classes="px s" Fill="#A6B858" Canvas.Left="150" Canvas.Top="1660" />
                    <Rectangle Classes="px"   Fill="#A8613A" Canvas.Left="905" Canvas.Top="1690" />
                </Canvas>

                <!-- 5 khối nội dung, các hàng * là khoảng trống tự chia đều -->
                <Grid RowDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto" Margin="0,70,0,260">

                    <!-- 1. Logo -->
                    <Border x:Name="LogoHome" Grid.Row="0" Classes="logo" />

                    <!-- 2. Tiêu đề -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <TextBlock Classes="h1" Text="ĐỐ VUI" FontSize="140" />
                        <Border Background="#A8613A" CornerRadius="28" Padding="44,10" HorizontalAlignment="Center"
                                BoxShadow="0 10 0 0 #5B2A17" Margin="0,-4,0,0">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-3" />
                            </Border.RenderTransform>
                            <TextBlock Text="CÙNG OLIVE!" FontFamily="{StaticResource Baloo}" FontSize="108" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <!-- 3. Mascot trong khung góc -->
                    <Panel Grid.Row="4" Width="760" Height="580">
                        <Border Width="80" Height="80" HorizontalAlignment="Left"  VerticalAlignment="Top"    BorderBrush="#A8613A" BorderThickness="8,8,0,0" CornerRadius="20,0,0,0" />
                        <Border Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top"    BorderBrush="#A8613A" BorderThickness="0,8,8,0" CornerRadius="0,20,0,0" />
                        <Border Width="80" Height="80" HorizontalAlignment="Left"  VerticalAlignment="Bottom" BorderBrush="#A8613A" BorderThickness="8,0,0,8" CornerRadius="0,0,0,20" />
                        <Border Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="#A8613A" BorderThickness="0,0,8,8" CornerRadius="0,0,20,0" />
                        <c:Mascot x:Name="HomeMascot" Expression="happy" Width="600" Height="490" />
                    </Panel>

                    <!-- 4. Hướng dẫn -->
                    <Border Grid.Row="6" Background="#C0FFFFFF" BorderBrush="#A6B858" BorderThickness="5"
                            CornerRadius="44" Padding="60,34" Width="900" HorizontalAlignment="Center">
                        <TextBlock x:Name="HomeRule" Classes="sub" FontSize="40" LineHeight="58" />
                    </Border>

                    <!-- 5. Nút bắt đầu -->
                    <StackPanel Grid.Row="8" HorizontalAlignment="Center" Spacing="30">
                        <Panel x:Name="StartHost" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Panel>

            <!-- ================= MÀN HÌNH CÂU HỎI (bố cục gọn) ================= -->
            <Panel x:Name="QuizScreen" Classes="screen" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                <!-- Hàng * (thứ 5) chứa lời giải thích, tự co giãn → nút TIẾP TỤC luôn nằm gọn ở đáy -->
                <Grid Width="900" HorizontalAlignment="Center" Margin="0,50,0,220"
                      RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

                    <!-- 1. Logo -->
                    <Border x:Name="LogoQuiz" Grid.Row="0" Classes="logo" Height="100" />

                    <!-- 2. Số câu + đồng hồ -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,30,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="QStep" Classes="h1" HorizontalAlignment="Left" FontSize="76" Text="CÂU 1/3" />
                            <StackPanel x:Name="QDots" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0" />
                        </StackPanel>
                        <Panel Grid.Column="1" Width="160" Height="160">
                            <c:TimerRing x:Name="Ring" />
                            <TextBlock x:Name="TimerNum" Text="20" FontFamily="{StaticResource Baloo}" FontSize="76" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Grid>

                    <!-- 3. Khung câu hỏi -->
                    <Panel Grid.Row="2" Margin="0,50,0,0">
                        <Border Background="White" CornerRadius="40" BorderBrush="#A8613A" BorderThickness="8"
                                BoxShadow="0 12 0 0 #5B2A17" MinHeight="300" Padding="70,56,100,46">
                            <TextBlock x:Name="QText" FontFamily="{StaticResource BvpBold}" FontSize="44" LineHeight="60"
                                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="#A8613A" CornerRadius="30" Padding="34,10" HorizontalAlignment="Center"
                                VerticalAlignment="Top" Margin="0,-28,0,0">
                            <TextBlock Text="CÂU HỎI DRCEUTICS" FontFamily="{StaticResource BvpBold}" FontSize="28" Foreground="White" />
                        </Border>
                        <c:Mascot x:Name="PeekMascot" Expression="think" Width="220" Height="179"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-40" />
                    </Panel>

                    <!-- 4. Đáp án -->
                    <StackPanel x:Name="Answers" Grid.Row="3" Spacing="20" Margin="0,44,0,0" />

                    <!-- 5. Lời giải thích (nằm trong vùng co giãn) -->
                    <Border x:Name="Feedback" Grid.Row="4" VerticalAlignment="Top" Margin="0,32,0,0"
                            Background="White" CornerRadius="32" Padding="36,20"
                            BoxShadow="0 8 0 0 #E8DCC6" Opacity="0">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
                            </Transitions>
                        </Border.Transitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="FbTitle" FontFamily="{StaticResource Baloo}" FontSize="44" />
                            <TextBlock x:Name="FbText" FontSize="32" LineHeight="44" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 6. Nút TIẾP TỤC -->
                    <Panel x:Name="NextHost" Grid.Row="5" HorizontalAlignment="Center" />
                </Grid>
            </Panel>

            <!-- ================= MÀN HÌNH KẾT QUẢ (không mascot, nội dung gom giữa màn hình) ================= -->
            <Panel x:Name="ResultScreen" Classes="screen" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                <Grid RowDefinitions="Auto,*" Margin="0,70,0,70">
                    <Border x:Name="LogoResult" Grid.Row="0" Classes="logo" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Tiêu đề + ô vuông hai bên -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                            <Canvas Width="60" Height="60" VerticalAlignment="Top">
                                <Rectangle Classes="px"   Fill="#A8613A" Canvas.Left="0"  Canvas.Top="30" />
                                <Rectangle Classes="px s" Fill="#A6B858" Canvas.Left="40" Canvas.Top="0" />
                            </Canvas>
                            <TextBlock x:Name="RTitle" Classes="h1" FontSize="112" VerticalAlignment="Center" Text="CHÚC MỪNG!" />
                            <Canvas Width="60" Height="60" VerticalAlignment="Top">
                                <Rectangle Classes="px s" Fill="#5B2A17" Canvas.Left="0"  Canvas.Top="40" />
                                <Rectangle Classes="px"   Fill="#A6B858" Canvas.Left="30" Canvas.Top="0" />
                            </Canvas>
                        </StackPanel>

                        <!-- Điểm -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,20,0,0">
                            <TextBlock Text="Bạn trả lời đúng" FontFamily="{StaticResource Baloo}" FontSize="52" VerticalAlignment="Center" />
                            <Border Background="#A6B858" CornerRadius="40" Padding="30,4">
                                <TextBlock x:Name="RScore" Text="2/3" FontFamily="{StaticResource Baloo}" FontSize="52" Foreground="White" />
                            </Border>
                            <TextBlock Text="câu" FontFamily="{StaticResource Baloo}" FontSize="52" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Hộp quà (chỉ hiện khi thắng) -->
                        <c:GiftBox x:Name="Gift" Width="460" Height="440" HorizontalAlignment="Center" Margin="0,60,0,0" />

                        <!-- Lời nhắn: cỡ 36, không tự xuống dòng -->
                        <TextBlock x:Name="RMsg" FontSize="36" LineHeight="54" TextAlignment="Center" TextWrapping="NoWrap"
                                   HorizontalAlignment="Center" Margin="0,50,0,0" />

                        <!-- Nút -->
                        <StackPanel x:Name="ResultBtns" Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" Margin="0,80,0,0" />

                        <!-- Đếm ngược -->
                        <TextBlock x:Name="RCount" FontSize="30" Foreground="#A8613A" Opacity="0.7" HorizontalAlignment="Center" Margin="0,40,0,0" />
                    </StackPanel>
                </Grid>
                <Canvas x:Name="Confetti" IsHitTestVisible="False" />
            </Panel>
        </Panel>
    </Viewbox>
</Window>